<UserControl x:Class="Activity_Finder.HobbyMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Height="700" Width="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER TOOLBAR -->
        <Border Grid.Row="0" Background="White" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="#F0F2F5" CornerRadius="10" Padding="10,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"/>
                        <TextBox x:Name="TxtSearchLocation" Width="220" BorderThickness="0" Background="Transparent" 
                                 VerticalContentAlignment="Center" FontSize="14" Foreground="#2D3436" 
                                />
                        <Button Content="🔍" Click="SearchLocation_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5"/>
                    </StackPanel>
                </Border>

                <!-- Controls & Scan -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Scan Range:" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="RangeSlider" Width="150" Minimum="1" Maximum="100" Value="10" 
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                            ValueChanged="RangeSlider_ValueChanged"/>
                    <TextBlock x:Name="LblRangeText" Text="10 KM" FontWeight="Black" Foreground="#2D3436" VerticalAlignment="Center" Margin="10,0,15,0" Width="70"/>

                    <Button Click="MyPin_Click" Cursor="Hand" Margin="0,0,5,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#2D3436" CornerRadius="8" Padding="15,8">
                                    <TextBlock Text="MY PIN" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="ScanArea_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FF6B6B" CornerRadius="8" Padding="15,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="SCAN" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAP VIEW -->
        <wv2:WebView2 Grid.Row="1" x:Name="MapWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Anchor for Details Popup -->
        <Border x:Name="PopupAnchor" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="320" Height="0" Margin="0,0,30,30"/>

        <!-- DETAILS POPUP (Fără poză) -->
        <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=PopupAnchor}" Placement="Top" AllowsTransparency="True" StaysOpen="True">
            <Border Width="320" Background="White" CornerRadius="25" Padding="25" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Event Details" FontWeight="Black" FontSize="20" Foreground="#2D3436"/>
                        <Button Content="X" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                                FontWeight="Bold" FontSize="16" Foreground="#D63031" Cursor="Hand" Click="CloseDetails_Click"/>
                    </Grid>
                    <TextBlock x:Name="LblDetTitle" Text="Title" FontWeight="Bold" FontSize="18" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LblDetDesc" Text="Description..." TextWrapping="Wrap" Margin="0,5,0,10" FontSize="14" Foreground="#2D3436"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="📍 "/>
                        <TextBlock x:Name="LblDetAddress" Text="Address" TextWrapping="Wrap" MaxWidth="250" FontWeight="SemiBold" Foreground="#636E72"/>
                    </StackPanel>
                    <TextBlock x:Name="LblDetPeople" Text="People" Foreground="#636E72" Margin="0,5,0,20" FontSize="14" FontWeight="SemiBold"/>
                    <Button Content="JOIN THIS HOBBY" Height="45" FontWeight="Bold" Foreground="White" Cursor="Hand" Click="JoinHobby_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF6B6B" Offset="0"/>
                                            <GradientStop Color="#FF9E5E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>