<Window x:Class="Activity_Finder.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hobby App" Height="800" Width="1000" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ImagePathToImageSourceConverter x:Key="ImageConverter" xmlns:local="clr-namespace:Activity_Finder"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2D3436"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3" Color="Gray"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0.0" />
                <GradientStop Color="#FF9E5E" Offset="0.5" />
                <GradientStop Color="#FFD93D" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CCFFFFFF" Padding="15" Margin="20,15,20,5" CornerRadius="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderTitle"
                           Text="👑 HOBBY APP"
                           VerticalAlignment="Center"
                           FontWeight="Black"
                           FontSize="18"
                           Foreground="#FF6B6B"
                           Margin="10,0,20,0"/>

                <Border x:Name="SearchArea"
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="15"
                        MaxWidth="350"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Foreground="Gray" Margin="5,0"/>
                        <TextBox x:Name="MainSearchBox"
                                 Width="260"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="5"
                                 Tag="Search activities..."
                                 TextChanged="MainSearchBox_TextChanged"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnNavHome"
                            Content="Home"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ShowHome_Click"
                            Foreground="#FF6B6B"/>

                    <Button x:Name="BtnNavProfile"
                            Content="Profile"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnNavProfile_Click"/>

                    <Button x:Name="BtnNavSettings"
                            Content="Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ShowSettings_Click"/>

                    <Button x:Name="BtnNavSupport"
                            Content="Support"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnNavSupport_Click"/>

                    <Button x:Name="BtnNavRequests"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Requests_Click">
                        <Grid>
                            <TextBlock Text="Requests"/>

                            <Border x:Name="RequestsBadge"
                                    Background="#FF6B6B"
                                    CornerRadius="9"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="58,-10,-14,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="RequestsBadgeText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContentArea" Grid.Row="1">
            <Grid x:Name="DashboardView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="EXPLORE CATEGORIES" Style="{StaticResource ActionButtonStyle}" Click="Categories_Click"/>
                    <Button Content="POST A HOBBY" Style="{StaticResource ActionButtonStyle}" Click="PostHobby_Click"/>
                    <Button Content="HOBBY MAP" Style="{StaticResource ActionButtonStyle}" Click="HobbyMap_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="25,5,25,25">
                    <ItemsControl x:Name="HobbyFeedControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="20"
                                        Margin="0,0,0,15"
                                        Padding="20"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="HobbyCard_Click">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="65"
                                                Height="65"
                                                CornerRadius="32.5"
                                                Background="#F0F2F5"
                                                VerticalAlignment="Top">
                                            <Ellipse Width="65" Height="65">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding User.ProfileImagePath, Converter={StaticResource ImageConverter}}"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="18,0">
                                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Black" Foreground="#2D3436"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                                                <TextBlock Text="by " FontSize="12" Foreground="#B2BEC3" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding User.Username}" FontSize="12" Foreground="#636E72" FontWeight="Bold"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <Border Background="#FFF0F0" CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="#FF6B6B"/>
                                                </Border>

                                                <TextBlock Text="{Binding City}"
                                                      Margin="15,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="#636E72"
                                                      FontWeight="SemiBold"
                                                      FontSize="13"/>
                                            </StackPanel>

                                            <TextBlock Margin="0,3" Foreground="#636E72">
                                                <Run Text="📅 "/>
                                                <Run Text="{Binding Date, StringFormat={}{0:dd MMM yyyy}}"/>
                                                <Run Text="  |  🕒 "/>
                                                <Run Text="{Binding Date, StringFormat={}{0:HH:mm}}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="PEOPLE"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#B2BEC3"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,3"/>

                                            <Border Background="#FF6B6B" CornerRadius="12" Padding="12,6">
                                                <TextBlock Text="{Binding MaxPeople}"
                                                           Foreground="White"
                                                           FontWeight="Black"
                                                           FontSize="18"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ContentControl>

        <Button x:Name="BtnChat"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,35,35"
                Width="70"
                Height="70"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="OpenConversations_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="bg" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Opacity="0.3"
                                                  ShadowDepth="5"
                                                  Color="Gray"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <TextBlock Text="💬"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,2,2"/>

                        <Border x:Name="ChatBadge"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Background="#FF3B30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Visibility="Collapsed">

                            <TextBlock x:Name="ChatBadgeText"
                                       Text="0"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Fill" Value="#F8F9FA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>