<UserControl x:Class="Activity_Finder.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Activity_Finder"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Border Background="#CCFFFFFF" CornerRadius="30" Margin="40,10,40,40" Padding="30" MaxWidth="650" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="APP SETTINGS" FontSize="28" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                    <TextBlock Text="USER ACCOUNT" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8" FontSize="12"/>
                    <Border Background="White" CornerRadius="15" Padding="15" Margin="0,0,0,20">
                        <Grid Margin="0,5">
                            <TextBlock Text="Display Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox x:Name="DisplayNameInput" Width="220" HorizontalAlignment="Right" Padding="8" Background="#F5F6FA" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="APP PREFERENCES" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8" FontSize="12"/>
                    <Border Background="White" CornerRadius="15" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,5">
                                <TextBlock Text="Push Notifications" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="PushYes" Content="YES" Margin="0,0,10,0" FontWeight="Bold" Foreground="#45B649"/>
                                    <RadioButton x:Name="PushNo" Content="NO" FontWeight="Bold" Foreground="#FF6B6B"/>
                                </StackPanel>
                            </Grid>
                            <Separator Background="#F5F6FA" Margin="0,10"/>
                            <Grid Margin="0,5">
                                <TextBlock Text="Distance Unit" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="KmRadio" Content="KM" Margin="0,0,10,0" FontWeight="Bold" Foreground="#2D3436"/>
                                    <RadioButton x:Name="MilesRadio" Content="MILES" FontWeight="Bold" Foreground="#2D3436"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PRIVACY &amp; VISIBILITY" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8" FontSize="12"/>
                    <Border Background="White" CornerRadius="15" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,5">
                                <TextBlock Text="Profile Visibility" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="VisibilityCombo" Width="150" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Everyone"/>
                                    <ComboBoxItem Content="Friends Only"/>
                                    <ComboBoxItem Content="Private"/>
                                </ComboBox>
                            </Grid>
                            <Separator Background="#F5F6FA" Margin="0,10"/>
                            <Grid Margin="0,5">
                                <TextBlock Text="Show Hobby Badge" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="BadgeOn" Content="ON" Margin="0,0,10,0" FontWeight="Bold" Foreground="#45B649"/>
                                    <RadioButton x:Name="BadgeOff" Content="OFF" FontWeight="Bold" Foreground="#FF6B6B"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnApplyChanges" Click="BtnApplyChanges_Click" Height="55" BorderThickness="0" Foreground="White" FontWeight="Black" FontSize="18" Cursor="Hand" Margin="0,10,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="27" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#45B649" Offset="0.0"/>
                                <GradientStop Color="#DCE35B" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Content>APPLY CHANGES</Button.Content>
                    </Button>

                    <Separator Background="#FF6B6B" Margin="0,20" Opacity="0.3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="LOGOUT" Click="Logout_Click" Foreground="#636E72" Background="Transparent" BorderThickness="0" FontWeight="Bold" Margin="10,0" Cursor="Hand"/>
                        <TextBlock Text="|" Foreground="Silver" VerticalAlignment="Center"/>
                        <Button Content="DELETE ACCOUNT" Click="DeleteAccount_Click" Foreground="#FF6B6B" Background="Transparent" BorderThickness="0" FontWeight="Bold" Margin="10,0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>