<UserControl x:Class="Activity_Finder.ConversationsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0"/>
                <GradientStop Color="#FF9E5E" Offset="0.55"/>
                <GradientStop Color="#FFD93D" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White"
                CornerRadius="28"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="← Back"
                            Width="85"
                            Height="34"
                            Background="#FF6B6B"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Back_Click"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Chats"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#FF6B6B"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Conversațiile tale"
                                   FontSize="13"
                                   Foreground="#636E72"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="ConversationsList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         MouseDoubleClick="ConversationsList_MouseDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         Padding="0">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,14"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="22">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF7F4"
                                    CornerRadius="22"
                                    Padding="14"
                                    Cursor="Hand">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="52"
                                            Height="52"
                                            CornerRadius="26"
                                            Background="#FF6B6B">
                                        <TextBlock Text="💬"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding HobbyName}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#2D3436"/>

                                        <TextBlock Text="{Binding OtherPerson}"
                                                   FontSize="13"
                                                   Foreground="#636E72"
                                                   Margin="0,2,0,0"/>

                                        <TextBlock Text="{Binding LastMessage}"
                                                   FontSize="12"
                                                   Foreground="#999"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>