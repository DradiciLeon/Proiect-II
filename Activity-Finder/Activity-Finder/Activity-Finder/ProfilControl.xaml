<UserControl x:Class="Activity_Finder.ProfilControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#CCFFFFFF" CornerRadius="30" Margin="20" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,10,0,15" HorizontalAlignment="Center">
                    <Button Click="UploadPhoto_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="120" Height="120">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="White" CornerRadius="60" x:Name="border"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid IsHitTestVisible="False">
                        <TextBlock x:Name="CameraIcon" Text="👤" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>
                        <Ellipse Width="120" Height="120">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ProfilePictureBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Grid>

                <TextBlock Text="DISPLAY NAME" FontSize="10" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,5"/>
                <Border Background="White" CornerRadius="10" Margin="0,0,0,12">
                    <TextBox x:Name="DisplayNameInput" Background="Transparent" BorderThickness="0" Padding="8" FontSize="14" FontWeight="Bold"/>
                </Border>

                <TextBlock Text="BIO" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,5" FontSize="10"/>
                <Border Background="White" CornerRadius="12" Padding="8" Margin="0,0,0,15">
                    <TextBox x:Name="BioInput" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" FontSize="12"/>
                </Border>

                <TextBlock Text="LOCATION" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,5" FontSize="10"/>

                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <Border Background="White" CornerRadius="10">
                            <TextBox x:Name="LocationInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="8"
                                     FontSize="12"
                                     TextChanged="LocationInput_TextChanged"/>
                        </Border>

                        <Border x:Name="SuggestionsBorder"
                                Background="White"
                                CornerRadius="10"
                                BorderBrush="#FF9E5E"
                                BorderThickness="1"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"
                                MaxHeight="120">
                            <ListBox x:Name="LocationSuggestionsBox"
                                     BorderThickness="0"
                                     SelectionChanged="LocationSuggestionsBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Button x:Name="SaveProfileButton" Content="SAVE CHANGES" Click="SaveProfile_Click" FontWeight="Black" Foreground="White" Background="#FF6B6B" Height="40" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="12" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#CCFFFFFF" CornerRadius="30" Margin="0,20,20,20" Padding="25">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>

                    <TextBlock Text="ACTIVITIES JOINED" FontSize="18" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,12"/>

                    <Border Background="#FDF5F2" CornerRadius="18" Padding="15" Margin="0,15,0,30">
                        <ItemsControl x:Name="JoinedActivitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="14"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ActivityCard_Click">

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#2D3436"/>

                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#FF8A5B"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Foreground="#636E72" Margin="0,4,0,0">
                                                <Run Text="📍 "/>
                                                <Run Text="{Binding City}"/>
                                            </TextBlock>

                                            <TextBlock Foreground="#636E72" Margin="0,3,0,0">
                                                <Run Text="📅 "/>
                                                <Run Text="{Binding Date, StringFormat={}{0:dd MMM yyyy HH:mm}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="MY HOBBIES" FontSize="18" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,12"/>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <ItemsControl x:Name="InterestsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="15" Padding="12,7" Margin="0,0,10,10" BorderBrush="#FF9E5E" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FF9E5E"/>
                                            <Button Click="DeleteInterest_Click" CommandParameter="{Binding}" Content="✕" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#FF6B6B" FontWeight="Bold" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="BtnAddHobby" Click="BtnAddHobby_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="White" Opacity="0.5" CornerRadius="15" Height="40" Padding="15,0" BorderBrush="#FF9E5E" BorderThickness="1">
                                        <TextBlock Text="+ Add Hobby" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#FF9E5E"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>

                    <Popup x:Name="HobbyPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnAddHobby}" Placement="Bottom">
                        <Border Background="White" CornerRadius="10" BorderBrush="#FF9E5E" BorderThickness="1" Padding="5" Width="150">
                            <ListBox x:Name="HobbySelector" BorderThickness="0" SelectionChanged="HobbySelector_SelectionChanged" Height="200" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBoxItem Content="⚽ Sport"/>
                                <ListBoxItem Content="🎮 Gaming"/>
                                <ListBoxItem Content="🍕 Cooking"/>
                                <ListBoxItem Content="🏔️ Hiking"/>
                                <ListBoxItem Content="🎵 Music"/>
                                <ListBoxItem Content="🎨 Art"/>
                                <ListBoxItem Content="📚 Reading"/>
                                <ListBoxItem Content="✈️ Travel"/>
                                <ListBoxItem Content="💻 Tech"/>
                            </ListBox>
                        </Border>
                    </Popup>

                    <TextBlock Text="MY ACTIVITIES" FontSize="18" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,12"/>

                    <Border Background="#FDF5F2" CornerRadius="18" Padding="15">
                        <ItemsControl x:Name="MyActivitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="14"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ActivityCard_Click">

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#2D3436"/>

                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#FF8A5B"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Foreground="#636E72" Margin="0,4,0,0">
                                                <Run Text="📍 "/>
                                                <Run Text="{Binding City}"/>
                                            </TextBlock>

                                            <TextBlock Foreground="#636E72" Margin="0,3,0,0">
                                                <Run Text="📅 "/>
                                                <Run Text="{Binding Date, StringFormat={}{0:dd MMM yyyy HH:mm}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>