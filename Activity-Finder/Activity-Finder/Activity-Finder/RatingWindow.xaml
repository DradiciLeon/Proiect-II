<Window x:Class="Activity_Finder.RatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rate Activity" Height="360" Width="400" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">

    <Border Background="White" CornerRadius="30" Margin="10" Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Opacity="0.3" ShadowDepth="0" Color="Black"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Cum a fost activitatea?" FontSize="24" FontWeight="Black" Foreground="#2D3436" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtHobbyName" Text="Nume Activitate" FontSize="16" Foreground="#FF6B6B" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,25"/>

            <TextBlock Text="Acordă o notă organizatorului:" FontSize="13" Foreground="#636E72" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="55"/>
                        <Setter Property="Height" Value="55"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#FFEAA7" BorderThickness="1">
                                        <TextBlock x:Name="starIcon" Text="⭐" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FFF9C4"/>
                                            <Setter TargetName="starIcon" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Button Click="Rate_Click" Tag="1"/>
                <Button Click="Rate_Click" Tag="2"/>
                <Button Click="Rate_Click" Tag="3"/>
                <Button Click="Rate_Click" Tag="4"/>
                <Button Click="Rate_Click" Tag="5"/>
            </StackPanel>

            <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                <TextBlock Text="MAI TÂRZIU" Foreground="#B2BEC3" FontWeight="Bold" FontSize="12" TextDecorations="Underline"/>
            </Button>
        </StackPanel>
    </Border>
</Window>