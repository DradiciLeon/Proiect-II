<Window x:Class="Activity_Finder.ExploreCateg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explore categories"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0.0" />
                <GradientStop Color="#FF9E5E" Offset="0.5" />
                <GradientStop Color="#FFD93D" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel x:Name="CategoriesView" Visibility="Visible" Margin="40">
            <TextBlock Text="EXPLORE CATEGORIES"
                       FontSize="38"
                       FontWeight="Black"
                       Foreground="White"
                       Margin="10,0,0,45"/>

            <WrapPanel>
                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Sport" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="SPORT" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Hiking" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="HIKING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="TV Shows" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="TV SHOWS" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Outdoors" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="OUTDOORS" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Parties" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="PARTIES" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Gaming" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="GAMING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Cooking" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="COOKING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Music" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="MUSIC" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Travel" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="TRAVEL" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Reading" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="READING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Tech" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="TECH" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12" Cursor="Hand" Tag="Fitness" MouseLeftButtonDown="Category_Click">
                    <TextBlock Text="FITNESS" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                </Border>
            </WrapPanel>
        </StackPanel>

        <StackPanel x:Name="ActivitiesView" Visibility="Collapsed" Margin="40">
            <Button Content="← Back"
                    Width="90"
                    Height="35"
                    HorizontalAlignment="Left"
                    Click="Back_Click"
                    Margin="0,0,0,20"/>

            <TextBlock x:Name="SelectedCategoryTitle"
                       FontSize="32"
                       FontWeight="Black"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <ListBox x:Name="ActivitiesList"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="18"
                                Padding="18"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding City}" Foreground="Gray" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Date}" Foreground="#636E72" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding MaxPeople, StringFormat=Max people: {0}}" Foreground="#636E72" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="NoActivitiesText"
                       Text="No activities found in this category."
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"/>
        </StackPanel>
    </Grid>
</Window>