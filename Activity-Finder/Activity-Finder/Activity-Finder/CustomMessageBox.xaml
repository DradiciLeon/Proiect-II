<Window x:Class="Activity_Finder.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="260"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="28" Padding="22">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5F6D" Offset="0"/>
                <GradientStop Color="#FFC371" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border Background="White"
                CornerRadius="24"
                Padding="24">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Hobby App"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF5F6D"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="MessageText"
                           Text="Message"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#333"
                           Margin="0,22,0,24"/>

                <Button Content="OK"
                        Height="42"
                        Width="140"
                        Background="#FF5F6D"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
