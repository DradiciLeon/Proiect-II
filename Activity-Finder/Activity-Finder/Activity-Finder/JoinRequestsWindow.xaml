<UserControl x:Class="Activity_Finder.JoinRequestsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Activity_Finder">

    <UserControl.Resources>
        <local:ImagePathToImageSourceConverter x:Key="ImageConverter"/>
    </UserControl.Resources>

    <Grid Margin="26">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5F6D" Offset="0"/>
                <GradientStop Color="#FFC371" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White"
                CornerRadius="28"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="←"
                            Width="42"
                            Height="42"
                            Background="#FF5F6D"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="20"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Back_Click"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Join Requests"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="#FF5F6D"/>

                        <TextBlock Text="Acceptă sau respinge participanți"
                                   FontSize="13"
                                   Foreground="#777"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="RequestsList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF7F4"
                                    CornerRadius="22"
                                    Padding="16"
                                    Margin="0,8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="62"
                                            Height="62"
                                            CornerRadius="31"
                                            ClipToBounds="True"
                                            VerticalAlignment="Top"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="OpenProfile_Click">
                                        <Image Source="{Binding ProfileImage, Converter={StaticResource ImageConverter}}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0">

                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#222"
                                                   Cursor="Hand"
                                                   MouseLeftButtonDown="OpenProfile_Click"/>

                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="13"
                                                   Foreground="#777"
                                                   Margin="0,2,0,0"
                                                   Cursor="Hand"
                                                   MouseLeftButtonDown="OpenProfile_Click"/>

                                        <TextBlock Text="{Binding HobbyName}"
                                                   FontSize="13"
                                                   Foreground="#FF5F6D"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="{Binding RequestedAt}"
                                                   FontSize="11"
                                                   Foreground="#999"
                                                   Margin="0,2,0,12"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Accept"
                                                    Width="100"
                                                    Height="38"
                                                    Background="#FF5F6D"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,10,0"
                                                    Click="Accept_Click"/>

                                            <Button Content="Reject"
                                                    Width="100"
                                                    Height="38"
                                                    Background="#EEEEEE"
                                                    Foreground="#333"
                                                    FontWeight="Bold"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="Reject_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>