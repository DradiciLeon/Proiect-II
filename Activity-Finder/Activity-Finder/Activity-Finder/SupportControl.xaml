<UserControl x:Class="Activity_Finder.SupportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="800" Width="1000">

    <Grid>
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25" Cursor="Hand" Click="BtnBack_Click" Panel.ZIndex="1">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#CCFFFFFF" CornerRadius="15" Padding="15,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="BACK" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Background="#EFFFFFFF" CornerRadius="30" Margin="20,80,20,20" MaxWidth="600" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="38,30">
                <StackPanel>
                    <TextBlock Text="HELP &amp; SUPPORT" FontSize="28" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Trimite-ne o problemă sau o sugestie." FontSize="14" Foreground="#636E72" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <TextBlock Text="MESAJUL TĂU" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,6"/>
                    <Border Background="White" CornerRadius="15" Margin="0,0,0,14" Padding="5">
                        <TextBox x:Name="TxtSupportMessage" 
                                 FontSize="14" 
                                 FontWeight="SemiBold" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="10" 
                                 Foreground="#2D3436" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 MinHeight="100" 
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <Button x:Name="BtnSendMessage" Click="BtnSendMessage_Click" Height="50" Margin="5,4,5,15" BorderThickness="0" Foreground="White" FontWeight="Black" FontSize="16" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="25" Background="#FF6B6B">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>📩 TRIMITE MESAJ</Button.Content>
                    </Button>

                    <Rectangle Height="1" Fill="#DFE6E9" Margin="0,10,0,15"/>

                    <TextBlock Text="CERERILE MELE" FontWeight="Black" FontSize="14" Foreground="#2D3436" Margin="5,0,0,8"/>

                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MyRequestsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="1"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Date}" FontSize="10" Foreground="#B2BEC3" FontWeight="Bold" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#2D3436" TextWrapping="Wrap"/>

                                                <Border Background="#F4F8FB" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="{Binding ReplyVisibility}">
                                                    <StackPanel>
                                                        <TextBlock Text="👑 Răspuns Admin:" FontSize="10" FontWeight="Black" Foreground="#74B9FF" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding AdminReply}" FontSize="12" Foreground="#2D3436" TextWrapping="Wrap" FontStyle="Italic"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="8" Padding="8,4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>