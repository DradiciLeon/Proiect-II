<Window x:Class="Activity_Finder.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Admin Dashboard - Hobby App" Height="750" Width="1000" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 1. Stil pentru Butonul de BAN (Roșu) -->
        <Style x:Key="BanButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D63031"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7675"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. Stil pentru Butonul de DELETE (Portocaliu) -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Stil General DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- FUNDAL GRADIENT CONSISTENT -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0.0" />
                <GradientStop Color="#FF9E5E" Offset="0.5" />
                <GradientStop Color="#FFD93D" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- BARA DE SUS (Search & Logout) -->
        <Border Grid.Row="0" Background="#CCFFFFFF" Padding="15" Margin="20,15,20,10" CornerRadius="20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛡️ ADMIN PANEL" FontSize="22" FontWeight="Black" Foreground="#2D3436" VerticalAlignment="Center" Margin="10,0,30,0"/>
                    <Border Background="White" CornerRadius="10" Padding="10,0" Width="300">
                        <Grid>
                            <!-- EVENIMENTUL DE SEARCH CONECTAT AICI -->
                            <TextBox x:Name="TxtSearchAdmin" BorderThickness="0" VerticalContentAlignment="Center" Height="30" Foreground="#2D3436"
                                     TextChanged="TxtSearchAdmin_TextChanged"/>
                            <TextBlock Text="Search users or posts..." Foreground="LightGray" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchAdmin}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- BUTON LOGOUT CONECTAT -->
                <Button Content="LOGOUT" Click="Logout_Click" HorizontalAlignment="Right" Width="100" Height="35" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#2D3436" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- CONȚINUT PRINCIPAL -->
        <Border Grid.Row="1" Background="#CCFFFFFF" Margin="20,10,20,20" CornerRadius="25" Padding="15">
            <TabControl Background="Transparent" BorderThickness="0">

                <!-- TAB 1: MANAGE USERS -->
                <TabItem Header="MANAGE USERS" FontWeight="Bold" Width="150" Height="40">
                    <Grid Margin="0,15,0,0">
                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>

                                <DataGridTemplateColumn Header="Ranking" Width="120" SortMemberPath="Score">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="⭐" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#FFD93D"/>
                                                <TextBlock Text="{Binding Score}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Management" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- BUTON BAN CONECTAT -->
                                            <Button Content="BAN USER" Style="{StaticResource BanButtonStyle}" Margin="5" Click="BanUser_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: MANAGE POSTS -->
                <TabItem Header="MANAGE POSTS" FontWeight="Bold" Width="150">
                    <Grid Margin="0,15,0,0">
                        <DataGrid x:Name="PostsGrid" AutoGenerateColumns="False" IsReadOnly="True" RowDetailsVisibilityMode="VisibleWhenSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hobby Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Owner" Binding="{Binding Author}" Width="120"/>

                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- BUTON DELETE CONECTAT -->
                                            <Button Content="DELETE" Style="{StaticResource DeleteButtonStyle}" Height="30" Click="DeletePost_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <!-- DETALII EXPANDABILE LA CLICK -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Background="#FDFDFD" Padding="20" BorderBrush="#FF9E5E" BorderThickness="4,0,0,0" Margin="10,5">
                                        <StackPanel>
                                            <TextBlock Text="FULL POST DETAILS" FontWeight="Black" FontSize="11" Foreground="#95A5A6" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="15" Foreground="#2D3436" Margin="0,0,0,15"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,30,0">
                                                    <TextBlock Text="📅 Posted:" FontWeight="Bold" Foreground="#636E72" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Date}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="👥 Needed:" FontWeight="Bold" Foreground="#636E72" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding PeopleCount}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Window>