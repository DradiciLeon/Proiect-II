<Window x:Class="Activity_Finder.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B6B" Offset="0.0" />
            <GradientStop Color="#FF9E5E" Offset="0.5" />
            <GradientStop Color="#FFD93D" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#EEFFFFFF" Padding="20" Margin="10,10,10,10" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="⚙️ ADMIN DASHBOARD" FontSize="24" FontWeight="Black" Foreground="#FF6B6B" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="White" CornerRadius="10" Padding="5" Margin="0,0,20,0" Width="250">
                        <TextBox x:Name="TxtSearchAdmin" 
                                 TextChanged="TxtSearchAdmin_TextChanged" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="5" 
                                 VerticalContentAlignment="Center" 
                                 Tag="Caută useri sau postări..."/>
                    </Border>

                    <Button Click="Logout_Click" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FF6B6B" CornerRadius="10" Padding="15,5">
                                    <TextBlock Text="LOGOUT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20,0,20,20" Background="Transparent" BorderThickness="0">

            <TabItem Header="👥 Users" FontSize="16" FontWeight="Bold">
                <Border Background="#F9FFFFFF" CornerRadius="15" Padding="15" Margin="0,10,0,0">
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="250"/>
                            <DataGridTextColumn Header="Scor (Hobby-uri)" Binding="{Binding Score}" Width="150"/>
                            <DataGridTemplateColumn Header="Acțiuni" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="BAN" Background="#FF3B30" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BanUser_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="📝 Posts" FontSize="16" FontWeight="Bold">
                <Border Background="#F9FFFFFF" CornerRadius="15" Padding="15" Margin="0,10,0,0">
                    <DataGrid x:Name="PostsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Titlu" Binding="{Binding Title}" Width="200"/>
                            <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="120"/>
                            <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="140"/>

                            <DataGridTemplateColumn Header="Acțiuni" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="DELETE" Background="#FF3B30" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="DeletePost_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#FFF5F5" Margin="10,5,10,15" Padding="15" CornerRadius="10" BorderBrush="#FFEAA7" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📋 Descriere completă:" FontWeight="Black" Foreground="#FF6B6B" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#2D3436" FontSize="13" Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="📍 Locație: " FontWeight="Bold" Foreground="#636E72" FontSize="12"/>
                                            <TextBlock Text="{Binding Location}" FontWeight="SemiBold" Foreground="#2D3436" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="🕒 Ora evenimentului: " FontWeight="Bold" Foreground="#636E72" FontSize="12"/>
                                            <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Foreground="#2D3436" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                            <TextBlock Text="👥 Participanți înscriși în activitate:" FontWeight="Bold" Foreground="#636E72" FontSize="12" Margin="0,0,0,4"/>
                                            <Border Background="White" CornerRadius="8" Padding="10,8" BorderBrush="#E4E7EB" BorderThickness="1">
                                                <TextBlock Text="{Binding Participants}" FontWeight="Black" Foreground="#2D3436" FontSize="13" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="🎧 Support Tickets" FontSize="16" FontWeight="Bold">
                <Border Background="#F9FFFFFF" CornerRadius="15" Padding="15" Margin="0,10,0,0">
                    <DataGrid x:Name="SupportGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="User" Binding="{Binding Author}" Width="120"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="140"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Acțiune" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="SolveTicket_Click" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Background="Transparent" IsEnabled="{Binding IsNotSolved}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="SolveBg" Background="#2ecc71" CornerRadius="5" Padding="10,4">
                                                        <TextBlock Text="✔ Solve" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="SolveBg" Property="Background" Value="#A8E6CF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#F4F8FB" Margin="10,5,10,15" Padding="15" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="✉️ Mesaj trimis de user:" FontWeight="Black" Foreground="#74B9FF" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#2D3436" FontSize="13" Margin="0,0,0,10"/>

                                        <TextBlock Text="👑 Răspunsul tău:" FontWeight="Black" Foreground="#2ecc71" Margin="0,0,0,5" Visibility="{Binding ReplyVisibility}"/>
                                        <TextBlock Text="{Binding AdminReply}" TextWrapping="Wrap" Foreground="#2D3436" FontSize="13" FontStyle="Italic" Visibility="{Binding ReplyVisibility}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <Border x:Name="ReplyPopup" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100" Grid.RowSpan="2">
            <Border Background="White" CornerRadius="20" Width="450" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <StackPanel>
                    <TextBlock Text="Trimite Răspuns (Opțional)" FontSize="20" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,5"/>
                    <TextBlock Text="Acest mesaj va fi vizibil utilizatorului." FontSize="12" Foreground="#636E72" Margin="0,0,0,15"/>

                    <Border Background="#F1F2F6" CornerRadius="10" Padding="5">
                        <TextBox x:Name="TxtAdminReply" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="10" FontSize="14"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Click="CancelReply_Click" Foreground="White" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#B2BEC3" CornerRadius="10" Padding="20,10">
                                        <TextBlock Text="Cancel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="ConfirmSolve_Click" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Black" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#2ecc71" CornerRadius="10" Padding="20,10">
                                        <TextBlock Text="✔ Solve &amp; Reply" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>