<Window x:Class="Activity_Finder.PostHobby"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Activity_Finder"
    mc:Ignorable="d"
    Title="Post a hobby" Height="700" Width="900" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0.0" />
                <GradientStop Color="#FF9E5E" Offset="0.5" />
                <GradientStop Color="#FFD93D" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border x:Name="PostHobbyView" 
            Visibility="Visible" 
            Background="#CCFFFFFF" 
            CornerRadius="30" 
            Padding="40" 
            Margin="20" 
            MaxWidth="550" 
            VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="POST YOUR HOBBY" FontSize="28" FontWeight="Black" Foreground="#2D3436" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <TextBlock Text="HOBBY NAME" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8"/>
                <Border Background="White" CornerRadius="15" Margin="0,0,0,20" Padding="5">
                    <TextBox x:Name="HobbyNameInput" 
                         FontSize="16" 
                         FontWeight="SemiBold" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Padding="10" 
                         Foreground="#2D3436"/>
                </Border>

                <TextBlock Text="SELECT CATEGORY" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8"/>
                <Border Background="White" CornerRadius="15" Margin="0,0,0,20">
                    <ComboBox x:Name="CategoryCombo" Height="45" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0">
                        <ComboBoxItem Content="Sport"/>
                        <ComboBoxItem Content="Hiking"/>
                        <ComboBoxItem Content="Gaming"/>
                        <ComboBoxItem Content="Parties"/>
                        <ComboBoxItem Content="Music"/>
                        <ComboBoxItem Content="Cooking"/>
                        <ComboBoxItem Content="Tech"/>
                    </ComboBox>
                </Border>

                <TextBlock Text="PICK A DATE" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8"/>
                <Border Background="White" CornerRadius="15" Margin="0,0,0,20" Padding="5">
                    <DatePicker x:Name="HobbyDate" Height="35" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Border>

                <TextBlock Text="PEOPLE NEEDED" FontWeight="Bold" Foreground="#636E72" Margin="5,0,0,8"/>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="PeopleSlider" Minimum="1" Maximum="20" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Width="45" Height="45" Margin="15,0,0,0">
                        <TextBlock Text="{Binding ElementName=PeopleSlider, Path=Value}" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Foreground="#FF6B6B"/>
                    </Border>
                </Grid>

                <Button x:Name="BtnPostFinal" Click="BtnPostFinal_Click" Height="60" BorderThickness="0" Foreground="White" FontWeight="Black" FontSize="18" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="30" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6B6B" Offset="0.0"/>
                            <GradientStop Color="#FF9E5E" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Content>POST NOW</Button.Content>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="5" Color="#FF6B6B"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
