<Window x:Class="Activity_Finder.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Activity_Finder"
        mc:Ignorable="d"
        Title="Sign Up" Height="550" Width="900" 
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8C42" Offset="0.0" />
                    <GradientStop Color="#FF3E96" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Ellipse Width="120" 
                     Height="120" 
                     Fill="White" 
                     Opacity="0.2"
                     Stroke="White" 
                     StrokeThickness="2" 
                     VerticalAlignment="Center" 
                     HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Column="1" Background="White" />

        <StackPanel Grid.Column="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Width="350">

            <TextBlock Text="Create Account" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#333" 
                       Margin="0,0,0,30" 
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Username" Foreground="#333" FontSize="16" Margin="0,10,0,5"/>
            <TextBox x:Name="UsernameBox" Height="35" Padding="5,6" Background="#FFF5F5F5" BorderThickness="0"/>

            <TextBlock Text="Email" Foreground="#333" FontSize="16" Margin="0,15,0,5"/>
            <TextBox x:Name="EmailBox" Height="35" Padding="5,6" Background="#FFF5F5F5" BorderThickness="0"/>

            <TextBlock Text="Password" Foreground="#333" FontSize="16" Margin="0,15,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="5,6" Background="#FFF5F5F5" BorderThickness="0"/>

            <TextBlock Text="Confirm Password" Foreground="#333" FontSize="16" Margin="0,15,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="35" Padding="5,6" Background="#FFF5F5F5" BorderThickness="0"/>

            <Button Content="SIGN UP" 
                    Margin="0,30,0,0" 
                    Height="40" 
                    Background="#FF3E96" 
                    Foreground="White" 
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="SignUp_Click"/>

            <Button Content="Back to Login" 
                    Margin="0,15,0,0" 
                    Height="30" 
                    Background="Transparent" 
                    Foreground="#FF8C42" 
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="BackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>