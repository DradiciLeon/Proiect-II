<Window x:Class="Activity_Finder.ExploreCateg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Activity_Finder"
        mc:Ignorable="d"
            Title="Explore categories" Height="600" Width="900" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0.0" />
                <GradientStop Color="#FF9E5E" Offset="0.5" />
                <GradientStop Color="#FFD93D" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel x:Name="CategoriesView" Visibility="Visible" Margin="40">
            <TextBlock Text="EXPLORE CATEGORIES" 
                   FontSize="38" 
                   FontWeight="Black" 
                   Foreground="White" 
                   Margin="10,0,0,45">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <WrapPanel>
                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="SPORT" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="HIKING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="TV SHOWS" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="OUTDOORS" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="PARTIES" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="GAMING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="COOKING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="MUSIC" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="TRAVEL" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="READING" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="TECH" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>

                <Border Background="White" CornerRadius="28" Padding="35,22" Margin="12">
                    <TextBlock Text="FITNESS" FontWeight="Black" FontSize="18" Foreground="#2D3436"/>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="10" Color="#636E72"/>
                    </Border.Effect>
                </Border>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
