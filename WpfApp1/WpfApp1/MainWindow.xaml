        <TextBlock Text="Introduceți numele:" Margin="0,0,0,10"/>
        <TextBox x:Name="InputName" Height="30" Margin="0,0,0,10"/>
        <Button x:Name="BtnAction" Content="Salută" Height="40"/>
        <TextBlock x:Name="TxtResult" Margin="0,10,0,0" FontSize="16" FontWeight="Bold"/>
    </StackPanel>
</Window>